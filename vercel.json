{
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "edu-converter.vercel.app" }],
      "destination": "https://plopp-sh.vercel.app/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/download", "destination": "/api/go?to=download" }
  ]
}
